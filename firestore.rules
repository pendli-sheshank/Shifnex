rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Helpers -----------------------------------------------------------

    // True when the caller holds a membership document for the given team.
    // Membership documents use the deterministic id "{teamId}_{userId}", so a
    // single exists() proves membership without needing a query.
    function isTeamMember(teamId) {
      return request.auth != null
        && exists(/databases/$(database)/documents/team_members/$(teamId + '_' + request.auth.uid));
    }

    // True when the caller owns the given team.
    function isTeamOwner(teamId) {
      return request.auth != null
        && exists(/databases/$(database)/documents/teams/$(teamId))
        && get(/databases/$(database)/documents/teams/$(teamId)).data.ownerId == request.auth.uid;
    }

    // Validates the optional team fields (company, working hours, address).
    // Each field is optional; when present it must be the right type/length.
    function teamOptionalFieldsValid(data) {
      return (!('companyName' in data) || (data.companyName is string && data.companyName.size() <= 100))
        && (!('addressLine' in data) || (data.addressLine is string && data.addressLine.size() <= 200))
        && (!('city' in data) || (data.city is string && data.city.size() <= 100))
        && (!('region' in data) || (data.region is string && data.region.size() <= 100))
        && (!('postalCode' in data) || (data.postalCode is string && data.postalCode.size() <= 20))
        && (!('open24Hours' in data) || data.open24Hours is bool)
        && (!('weeklyCycleStartDay' in data) || data.weeklyCycleStartDay is int)
        && (!('workStartMinutes' in data) || (data.workStartMinutes is int && data.workStartMinutes >= 0 && data.workStartMinutes <= 1440))
        && (!('workEndMinutes' in data) || (data.workEndMinutes is int && data.workEndMinutes >= 0 && data.workEndMinutes <= 1440));
    }

    // Pay-cycle fields on a job. Both are optional: every job created before pay
    // frequency existed lacks them, and both clients write the whole document on
    // every save, so requiring them would reject writes from older app versions.
    function jobPayCycleFieldsValid(data) {
      return (!('payFrequency' in data)
          || data.payFrequency in ['WEEKLY', 'BIWEEKLY', 'MONTHLY'])
        && (!('payCycleAnchorMillis' in data)
          || (data.payCycleAnchorMillis is int && data.payCycleAnchorMillis >= 0));
    }

    // Profiles: users can only read/write their own profile
    match /profiles/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId
        && request.resource.data.full_name is string
        && request.resource.data.full_name.size() <= 100
        && request.resource.data.email is string;
      allow update: if request.auth != null && request.auth.uid == userId
        && request.resource.data.full_name is string
        && request.resource.data.full_name.size() <= 100
        && request.resource.data.email is string;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Settings: users can only read/write their own settings
    match /settings/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId
        && (!('remindersEnabled' in request.resource.data) || request.resource.data.remindersEnabled is bool)
        && (!('defaultReminderMinutes' in request.resource.data) || request.resource.data.defaultReminderMinutes is int);
    }

    // Shifts: users can only CRUD their own shifts
    match /shifts/{shiftId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.userId is string
        && request.resource.data.company is string
        && request.resource.data.company.size() <= 200
        && request.resource.data.startTime is int
        && request.resource.data.endTime is int
        && request.resource.data.endTime > request.resource.data.startTime
        && request.resource.data.hourlyRate is number
        && request.resource.data.hourlyRate >= 0
        && (!('notes' in request.resource.data) || (request.resource.data.notes is string && request.resource.data.notes.size() <= 1000))
        && (request.resource.data.userId == request.auth.uid
          || ('teamShiftId' in request.resource.data
            && get(/databases/$(database)/documents/team_shifts/$(request.resource.data.teamShiftId)).data.assignedTo == request.resource.data.userId
            && get(/databases/$(database)/documents/team_shifts/$(request.resource.data.teamShiftId)).data.assignedBy == request.auth.uid));
      allow update: if request.auth != null
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.company is string
        && request.resource.data.company.size() <= 200
        && request.resource.data.startTime is int
        && request.resource.data.endTime is int
        && request.resource.data.endTime > request.resource.data.startTime
        && request.resource.data.hourlyRate is number
        && request.resource.data.hourlyRate >= 0
        && (!('notes' in request.resource.data) || (request.resource.data.notes is string && request.resource.data.notes.size() <= 1000));
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // Jobs: users can only read/write their OWN jobs. (Previously any signed-in
    // user could read every user's job titles and pay rates.)
    match /jobs/{jobId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 200
        && request.resource.data.defaultHourlyRate is number
        && request.resource.data.defaultHourlyRate >= 0
        && request.resource.data.goalHours is number
        && request.resource.data.goalHours >= 0
        && jobPayCycleFieldsValid(request.resource.data);
      allow update: if request.auth != null
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 200
        && request.resource.data.defaultHourlyRate is number
        && request.resource.data.defaultHourlyRate >= 0
        && request.resource.data.goalHours is number
        && request.resource.data.goalHours >= 0
        && jobPayCycleFieldsValid(request.resource.data);
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // Pay Adjustments: users can only CRUD their own adjustments
    match /pay_adjustments/{adjustmentId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.cycleKey is string
        && request.resource.data.employer is string
        && request.resource.data.type is string
        && request.resource.data.amount is number;
      allow update: if request.auth != null
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.cycleKey is string
        && request.resource.data.employer is string
        && request.resource.data.type is string
        && request.resource.data.amount is number;
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // Feedback: bug reports and suggestions submitted from the in-app feedback
    // screen. A report is immutable once written — update and delete are denied
    // outright — so it can't be edited or withdrawn after triage has started on
    // it. That also means the screenshot must be uploaded before the document is
    // created, since there is no second write to attach the URL.
    match /feedback/{feedbackId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly([
          'id', 'userId', 'userEmail', 'category', 'description',
          'stepsToReproduce', 'screenshotUrl', 'appVersion', 'platform',
          'osVersion', 'deviceModel', 'status', 'createdAt'
        ])
        && request.resource.data.userId == request.auth.uid
        // The client keys the document by its own id; requiring them to agree
        // keeps a report addressable by either.
        && request.resource.data.id == feedbackId
        // Triage state is server-side only: update is denied, so anything other
        // than the initial value here would be permanent and unearned.
        && request.resource.data.status == 'new'
        && request.resource.data.category in ['bug', 'feature', 'other']
        && request.resource.data.description is string
        // trim() so a description of only spaces can't satisfy the length floor —
        // the clients trim before sending, and this keeps the two in agreement.
        && request.resource.data.description.trim().size() > 0
        && request.resource.data.description.size() <= 2000
        && (!('stepsToReproduce' in request.resource.data)
          || (request.resource.data.stepsToReproduce is string
            && request.resource.data.stepsToReproduce.size() <= 2000))
        && (!('screenshotUrl' in request.resource.data)
          || (request.resource.data.screenshotUrl is string
            && request.resource.data.screenshotUrl.size() <= 1000))
        && request.resource.data.createdAt is number;
      allow update, delete: if false;
    }

    // Invite codes: a small public-by-secret lookup so joiners can resolve a
    // code to a teamId WITHOUT the teams collection being world-readable.
    // Reads are allowed only by exact document id (the code itself is the
    // secret) — never by list/query. Owners create/delete alongside the team.
    match /invite_codes/{code} {
      allow get: if request.auth != null;
      allow list: if false;
      allow create: if request.auth != null
        && request.resource.data.teamId is string
        && request.resource.data.keys().hasOnly(['teamId'])
        // During team creation the team doc is written in the same batch and is
        // not yet committed, so allow the not-yet-exists case (the batching
        // teams-create rule guarantees ownerId == the caller).
        && (!exists(/databases/$(database)/documents/teams/$(request.resource.data.teamId))
          || isTeamOwner(request.resource.data.teamId));
      allow delete: if request.auth != null
        && (!exists(/databases/$(database)/documents/teams/$(resource.data.teamId))
          || isTeamOwner(resource.data.teamId));
    }

    // Teams: readable only by members (and the owner); owner manages.
    match /teams/{teamId} {
      allow read: if isTeamMember(teamId) || (request.auth != null && resource.data.ownerId == request.auth.uid);
      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 100
        && request.resource.data.inviteCode is string
        && teamOptionalFieldsValid(request.resource.data);
      allow update: if request.auth != null
        && (
          // Owner may edit the team's own fields.
          (resource.data.ownerId == request.auth.uid
            && request.resource.data.ownerId == request.auth.uid
            && request.resource.data.name is string
            && request.resource.data.name.size() <= 100
            && teamOptionalFieldsValid(request.resource.data))
          // Any authenticated user may adjust ONLY the (cosmetic) member counter
          // — this is what a joining/leaving member does in the same batch as
          // their membership write. No other field may change.
          || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberCount'])
        );
      allow delete: if request.auth != null
        && resource.data.ownerId == request.auth.uid;
    }

    // Team Members: readable by the member themselves and by any teammate.
    // Self-join requires presenting the correct invite code; membership docs
    // must use the deterministic id "{teamId}_{userId}".
    match /team_members/{membershipId} {
      // A user may always get their own membership doc (including a "not found"
      // for a doc that does not exist yet — the pre-join existence check), and
      // teammates may read each other's membership docs.
      allow read: if request.auth != null
        && (resource == null
          || resource.data.userId == request.auth.uid
          || isTeamMember(resource.data.teamId));
      allow create: if request.auth != null
        && membershipId == request.resource.data.teamId + '_' + request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.teamId is string
        && request.resource.data.role is string
        && request.resource.data.keys().hasOnly(['teamId', 'userId', 'role', 'joinedAt', 'displayName', 'email', 'defaultHourlyRate', 'inviteCode'])
        && (!('defaultHourlyRate' in request.resource.data) || (request.resource.data.defaultHourlyRate is number && request.resource.data.defaultHourlyRate >= 0))
        && (
          // Self-join as a plain member: must present the correct invite code
          // for an existing team.
          (request.resource.data.role == "member"
            && exists(/databases/$(database)/documents/teams/$(request.resource.data.teamId))
            && get(/databases/$(database)/documents/teams/$(request.resource.data.teamId)).data.inviteCode == request.resource.data.inviteCode)
          // Owner creating their own manager row. The team is written in the
          // same batch as createTeam, so it may not be committed yet.
          || (request.resource.data.role == "manager"
            && (!exists(/databases/$(database)/documents/teams/$(request.resource.data.teamId))
              || isTeamOwner(request.resource.data.teamId)))
        );
      allow update: if request.auth != null
        && isTeamOwner(resource.data.teamId)
        && request.resource.data.teamId == resource.data.teamId
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.role is string
        && (request.resource.data.role == "member" || request.resource.data.role == "manager")
        && (!('defaultHourlyRate' in request.resource.data) || (request.resource.data.defaultHourlyRate is number && request.resource.data.defaultHourlyRate >= 0));
      allow delete: if request.auth != null
        && (resource.data.userId == request.auth.uid || isTeamOwner(resource.data.teamId));
    }

    // Team Shifts: readable by team members; managers assign, members respond.
    match /team_shifts/{shiftId} {
      allow read: if isTeamMember(resource.data.teamId);
      allow create: if request.auth != null
        && request.resource.data.teamId is string
        && isTeamOwner(request.resource.data.teamId)
        && request.resource.data.assignedTo is string
        && request.resource.data.assignedBy == request.auth.uid
        && request.resource.data.company is string
        && request.resource.data.startTime is int
        && request.resource.data.endTime is int
        && request.resource.data.endTime > request.resource.data.startTime
        && request.resource.data.hourlyRate is number
        && request.resource.data.hourlyRate >= 0
        && request.resource.data.status is string
        && (request.resource.data.status == "assigned" || request.resource.data.status == "accepted" || request.resource.data.status == "declined");
      allow update: if request.auth != null
        && request.resource.data.teamId == resource.data.teamId
        && request.resource.data.assignedBy == resource.data.assignedBy
        && request.resource.data.company == resource.data.company
        && request.resource.data.role == resource.data.role
        && request.resource.data.startTime == resource.data.startTime
        && request.resource.data.endTime == resource.data.endTime
        && request.resource.data.notes == resource.data.notes
        && (
          // Manager (assignedBy) or team owner can update mutable fields including
          // status, assignedTo and hourlyRate (a swap moves each person's rate with them).
          (resource.data.assignedBy == request.auth.uid
            || isTeamOwner(resource.data.teamId))
          // Assigned member can only change status to accepted or declined; assignedTo
          // and hourlyRate must stay the same.
          || (resource.data.assignedTo == request.auth.uid
            && request.resource.data.assignedTo == resource.data.assignedTo
            && request.resource.data.hourlyRate == resource.data.hourlyRate
            && (request.resource.data.status == "accepted" || request.resource.data.status == "declined"))
        );
      allow delete: if request.auth != null
        && resource.data.assignedBy == request.auth.uid;
    }

    // Schedule notifications: written by the shift assigner for the assignee;
    // only the recipient can read them, flip the read flag, or delete them.
    match /notifications/{notificationId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.userId is string
        && request.resource.data.type == "shift_assigned"
        && request.resource.data.teamShiftId is string
        && request.resource.data.company is string
        && request.resource.data.startTime is int
        && request.resource.data.endTime is int
        && request.resource.data.createdAt is int
        && request.resource.data.read == false
        && get(/databases/$(database)/documents/team_shifts/$(request.resource.data.teamShiftId)).data.assignedBy == request.auth.uid
        && get(/databases/$(database)/documents/team_shifts/$(request.resource.data.teamShiftId)).data.assignedTo == request.resource.data.userId;
      allow update: if request.auth != null
        && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // Team Messages: readable by team members; sender or owner can delete.
    match /team_messages/{messageId} {
      allow read: if isTeamMember(resource.data.teamId);
      allow create: if request.auth != null
        && request.resource.data.teamId is string
        && isTeamMember(request.resource.data.teamId)
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.senderName is string
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 2000
        && request.resource.data.isAnnouncement is bool
        && request.resource.data.isPinned is bool
        && request.resource.data.createdAt is int
        && (request.resource.data.text.size() > 0 || ('imageUrl' in request.resource.data && request.resource.data.imageUrl is string && request.resource.data.imageUrl.size() > 0))
        && (!request.resource.data.isAnnouncement
          || isTeamOwner(request.resource.data.teamId));
      allow update: if request.auth != null
        && request.resource.data.teamId == resource.data.teamId
        && request.resource.data.senderId == resource.data.senderId
        && request.resource.data.createdAt == resource.data.createdAt
        && (resource.data.senderId == request.auth.uid
          || isTeamOwner(resource.data.teamId)
          || (request.resource.data.text == resource.data.text
            && request.resource.data.keys().hasOnly(resource.data.keys())
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seenBy'])));
      allow delete: if request.auth != null
        && (resource.data.senderId == request.auth.uid
          || isTeamOwner(resource.data.teamId));
    }

    // Team Tasks: managers (team owner) create/delete; assignee or owner can advance status
    match /team_tasks/{taskId} {
      allow read: if isTeamMember(resource.data.teamId);
      allow create: if request.auth != null
        && request.resource.data.teamId is string
        && isTeamOwner(request.resource.data.teamId)
        && request.resource.data.assignedTo is string
        && request.resource.data.assignedBy == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 200
        && request.resource.data.status in ['pending', 'in_progress', 'completed'];
      allow update: if request.auth != null
        && request.resource.data.teamId == resource.data.teamId
        && request.resource.data.assignedTo == resource.data.assignedTo
        && request.resource.data.assignedBy == resource.data.assignedBy
        && request.resource.data.title == resource.data.title
        && request.resource.data.status in ['pending', 'in_progress', 'completed']
        && (
          isTeamOwner(resource.data.teamId)
          || resource.data.assignedTo == request.auth.uid
        );
      allow delete: if request.auth != null
        && isTeamOwner(resource.data.teamId);
    }

    // Swap Requests: requester creates, target responds, manager approves
    match /swap_requests/{requestId} {
      allow read: if isTeamMember(resource.data.teamId);
      allow create: if request.auth != null
        && request.resource.data.requesterId == request.auth.uid
        && request.resource.data.status == "pending"
        && request.resource.data.teamId is string
        && isTeamMember(request.resource.data.teamId)
        && request.resource.data.requesterShiftId is string
        && request.resource.data.targetMemberId is string
        && request.resource.data.targetShiftId is string
        && request.resource.data.createdAt is int
        // The two referenced shifts must belong to this same team.
        && get(/databases/$(database)/documents/team_shifts/$(request.resource.data.requesterShiftId)).data.teamId == request.resource.data.teamId
        && get(/databases/$(database)/documents/team_shifts/$(request.resource.data.targetShiftId)).data.teamId == request.resource.data.teamId;
      allow update: if request.auth != null
        && request.resource.data.teamId == resource.data.teamId
        && request.resource.data.requesterId == resource.data.requesterId
        && request.resource.data.requesterShiftId == resource.data.requesterShiftId
        && request.resource.data.targetMemberId == resource.data.targetMemberId
        && request.resource.data.targetShiftId == resource.data.targetShiftId
        && (
          // Target member can accept or decline a pending request
          (resource.data.targetMemberId == request.auth.uid
            && resource.data.status == "pending"
            && (request.resource.data.status == "target_accepted" || request.resource.data.status == "declined"))
          // Manager can approve or decline after target accepted
          || (isTeamOwner(resource.data.teamId)
            && resource.data.status == "target_accepted"
            && (request.resource.data.status == "approved" || request.resource.data.status == "declined"))
        );
      allow delete: if request.auth != null
        && resource.data.requesterId == request.auth.uid
        && resource.data.status == "pending";
    }
  }
}
